{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",

  // SnapQuote local profile: OpenAI + Gemini only.
  // Active global config is ~/.config/opencode/oh-my-openagent.json.
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [{ "model": "openai/gpt-5.4", "variant": "xhigh" }]
    },
    "hephaestus": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [{ "model": "openai/gpt-5.4", "variant": "xhigh" }]
    },
    "oracle": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        { "model": "google/gemini-3.1-pro-preview", "variant": "high" },
        { "model": "openai/gpt-5.4", "variant": "xhigh" }
      ]
    },
    "librarian": {
      "model": "google/gemini-3-flash-preview",
      "variant": "medium",
      "fallback_models": [{ "model": "openai/gpt-5.4-mini-fast" }]
    },
    "explore": {
      "model": "openai/gpt-5.4-mini-fast",
      "variant": "low",
      "fallback_models": [{ "model": "google/gemini-3-flash-preview" }]
    },
    "multimodal-looker": {
      "model": "google/gemini-3.1-pro-preview",
      "variant": "high",
      "fallback_models": [{ "model": "openai/gpt-5.5", "variant": "xhigh" }]
    },
    "prometheus": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        { "model": "openai/gpt-5.4", "variant": "xhigh" },
        { "model": "google/gemini-3.1-pro-preview", "variant": "high" }
      ]
    },
    "metis": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [{ "model": "openai/gpt-5.4", "variant": "xhigh" }]
    },
    "momus": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        { "model": "google/gemini-3.1-pro-preview", "variant": "high" },
        { "model": "openai/gpt-5.4", "variant": "xhigh" }
      ]
    },
    "atlas": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [{ "model": "openai/gpt-5.4", "variant": "xhigh" }]
    },
    "sisyphus-junior": {
      "model": "openai/gpt-5.4-mini-fast",
      "variant": "medium",
      "fallback_models": [{ "model": "google/gemini-3-flash-preview" }]
    }
  },

  "categories": {
    "visual-engineering": {
      "model": "google/gemini-3.1-pro-preview",
      "variant": "high",
      "fallback_models": [{ "model": "openai/gpt-5.5", "variant": "xhigh" }]
    },
    "ultrabrain": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [{ "model": "google/gemini-3.1-pro-preview", "variant": "high" }]
    },
    "deep": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [{ "model": "openai/gpt-5.4", "variant": "xhigh" }]
    },
    "artistry": {
      "model": "google/gemini-3.1-pro-preview",
      "variant": "high",
      "fallback_models": [{ "model": "openai/gpt-5.5", "variant": "xhigh" }]
    },
    "quick": {
      "model": "openai/gpt-5.4-mini"
    },
    "unspecified-low": {
      "model": "openai/gpt-5.4-mini-fast",
      "variant": "medium"
    },
    "unspecified-high": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    },
    "writing": {
      "model": "google/gemini-3-flash-preview",
      "variant": "medium",
      "fallback_models": [{ "model": "openai/gpt-5.4-mini-fast" }]
    }
  }
}
